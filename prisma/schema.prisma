generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  ABORTED
}

model ScrapingRun {
  id           Int       @id @default(autoincrement())
  apifyRunId   String?   @unique @map("apify_run_id")
  status       RunStatus @default(PENDING)

  // Input parameters
  searchQueries    String[] @map("search_queries")
  authorUrls       String[] @map("author_urls")
  authorsCompanies String[] @map("authors_companies")
  postedLimit      String   @default("24h") @map("posted_limit")
  maxPosts         Int      @default(100) @map("max_posts")
  maxComments      Int      @default(100) @map("max_comments")
  maxReactions     Int      @default(100) @map("max_reactions")
  scrapeComments   Boolean  @default(true) @map("scrape_comments")
  scrapeReactions  Boolean  @default(true) @map("scrape_reactions")
  scrapePages      Int      @default(1) @map("scrape_pages")
  sortBy           String   @default("date") @map("sort_by")

  // Timestamps
  createdAt  DateTime  @default(now()) @map("created_at")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  // Error info
  errorMessage String? @map("error_message")

  // Stats
  resultsCount Int @default(0) @map("results_count")

  // Relations
  results ScrapingResult[]

  @@map("scraping_runs")
}

model ScrapingResult {
  id    Int @id @default(autoincrement())
  runId Int @map("run_id")

  // Post type
  postType String? @map("post_type")

  // Post data
  postUrl  String? @map("post_url")
  postId   String? @map("post_id")
  postText String? @map("post_text")
  postDate DateTime? @map("post_date")

  // Author data
  authorName       String? @map("author_name")
  authorUrl        String? @map("author_url")
  authorUsername   String? @map("author_username")
  authorHeadline   String? @map("author_headline")
  authorAvatarUrl  String? @map("author_avatar_url")

  // Engagement
  likesCount    Int @default(0) @map("likes_count")
  commentsCount Int @default(0) @map("comments_count")
  sharesCount   Int @default(0) @map("shares_count")

  // Raw data (contains full reactions, comments, etc.)
  rawData Json? @map("raw_data")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  run ScrapingRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("scraping_results")
}

model Lead {
  id              Int      @id @default(autoincrement())
  linkedinUrl     String   @unique @map("linkedin_url")
  linkedinId      String?  @map("linkedin_id")

  // Profile info
  name            String
  position        String?
  avatarUrl       String?  @map("avatar_url")

  // Engagement tracking
  engagementTypes String[] @map("engagement_types") // ["LIKE", "COMMENT", "EMPATHY", etc.]

  // Source tracking
  sourcePostUrls  String[] @map("source_post_urls")
  sourceRunIds    Int[]    @map("source_run_ids")

  // Timestamps
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  @@map("leads")
}

// Individual engagement actions (Activity Feed)
model Engagement {
  id              Int      @id @default(autoincrement())

  // Person who engaged
  personLinkedinUrl   String  @map("person_linkedin_url")
  personName          String  @map("person_name")
  personPosition      String? @map("person_position")
  personAvatarUrl     String? @map("person_avatar_url")

  // Type of engagement
  engagementType      String  @map("engagement_type") // LIKE, COMMENT, EMPATHY, PRAISE, APPRECIATION

  // Post that was engaged with
  postUrl             String  @map("post_url")
  postText            String? @map("post_text") // First ~200 chars for preview
  postAuthorName      String? @map("post_author_name")
  postAuthorUrl       String? @map("post_author_url")

  // Comment text (if type=COMMENT)
  commentText         String? @map("comment_text")

  // Search context
  searchQuery         String? @map("search_query") // Which keyword matched

  // Source tracking
  runId               Int     @map("run_id")
  resultId            Int?    @map("result_id")

  // Timestamps
  engagedAt           DateTime? @map("engaged_at") // When the engagement happened (from LinkedIn)
  createdAt           DateTime @default(now()) @map("created_at") // When we found it

  // Unique constraint: one person can have one type of engagement per post
  @@unique([personLinkedinUrl, postUrl, engagementType])
  @@map("engagements")
}

// ==================== LINKEDIN AUTOMATION ====================

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ActionType {
  LIKE
  CONNECT
  CONNECT_NO_NOTE
  MESSAGE
  MESSAGE1
  COMMENT
  PROFILE_VIEW
}

// Browser automation session
model AutomationSession {
  id              Int      @id @default(autoincrement())

  // Session state
  isActive        Boolean  @default(false) @map("is_active")
  isLoggedIn      Boolean  @default(false) @map("is_logged_in")
  isPaused        Boolean  @default(false) @map("is_paused")

  // Browser user data directory (for persisting session)
  userDataDir     String?  @map("user_data_dir")

  // LinkedIn account info (detected after login)
  linkedinName    String?  @map("linkedin_name")
  linkedinUrl     String?  @map("linkedin_url")

  // Stats for current session
  actionsToday    Int      @default(0) @map("actions_today")
  lastActionAt    DateTime? @map("last_action_at")

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("automation_sessions")
}

// Queue of actions to perform
model ActionQueue {
  id              Int          @id @default(autoincrement())

  // Action details
  actionType      ActionType   @map("action_type")
  status          ActionStatus @default(PENDING)

  // Target
  targetUrl       String       @map("target_url") // Profile URL or Post URL
  targetName      String?      @map("target_name") // Person/Post name for display

  // Action data (for MESSAGE and COMMENT)
  messageText     String?      @map("message_text")

  // Source (which engagement triggered this)
  engagementId    Int?         @map("engagement_id")

  // Campaign link (for outreach actions)
  campaignId      Int?         @map("campaign_id")
  campaignLeadId  Int?         @map("campaign_lead_id")

  // Execution info
  attempts        Int          @default(0)
  lastAttemptAt   DateTime?    @map("last_attempt_at")
  completedAt     DateTime?    @map("completed_at")
  errorMessage    String?      @map("error_message")

  // Scheduling
  scheduledFor    DateTime?    @map("scheduled_for") // When to execute (null = ASAP)
  priority        Int          @default(0) // Higher = sooner

  // Timestamps
  createdAt       DateTime     @default(now()) @map("created_at")

  @@map("action_queue")
}

// Automation settings
model AutomationSettings {
  id              Int      @id @default(autoincrement())

  // Daily limits
  dailyLikeLimit       Int @default(20) @map("daily_like_limit")
  dailyConnectLimit    Int @default(10) @map("daily_connect_limit")
  dailyMessageLimit    Int @default(10) @map("daily_message_limit")
  dailyCommentLimit    Int @default(5) @map("daily_comment_limit")
  dailyTotalLimit      Int @default(50) @map("daily_total_limit")

  // Delays (in seconds)
  minDelayBetweenActions  Int @default(30) @map("min_delay_between_actions")
  maxDelayBetweenActions  Int @default(90) @map("max_delay_between_actions")

  // Working hours (24h format)
  workingHoursStart    Int @default(9) @map("working_hours_start")
  workingHoursEnd      Int @default(18) @map("working_hours_end")

  // Behavior
  enableRandomPauses   Boolean @default(true) @map("enable_random_pauses")
  pauseMinMinutes      Int @default(5) @map("pause_min_minutes")
  pauseMaxMinutes      Int @default(15) @map("pause_max_minutes")

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("automation_settings")
}

// Daily action statistics
model DailyStats {
  id              Int      @id @default(autoincrement())
  date            DateTime @db.Date

  // Action counts
  likesCount      Int @default(0) @map("likes_count")
  connectsCount   Int @default(0) @map("connects_count")
  messagesCount   Int @default(0) @map("messages_count")
  commentsCount   Int @default(0) @map("comments_count")
  totalCount      Int @default(0) @map("total_count")

  // Session info
  sessionMinutes  Int @default(0) @map("session_minutes")

  @@unique([date])
  @@map("daily_stats")
}

// ==================== OUTREACH CAMPAIGNS ====================

enum LeadTemperature {
  HOT
  WARM
}

enum LeadStatus {
  NEW
  INVITED
  CONNECTED
  MSG1
  DONE
}

// Outreach Campaign
model Campaign {
  id                  Int      @id @default(autoincrement())
  name                String

  // Message template (supports {{firstName}}, {{landingUrl}})
  message1Template    String?  @map("message1_template")
  landingUrl          String?  @map("landing_url")

  // Daily limits
  invitesPerDay       Int      @default(20) @map("invites_per_day")
  messagesPerDay      Int      @default(50) @map("messages_per_day")

  // Working hours (24h format)
  workingHoursStart   Int      @default(9) @map("working_hours_start")
  workingHoursEnd     Int      @default(18) @map("working_hours_end")

  // Status
  isActive            Boolean  @default(true) @map("is_active")
  pausedReason        String?  @map("paused_reason") // e.g., "INVITE_LIMIT"

  // Stats
  totalLeads          Int      @default(0) @map("total_leads")
  invitedCount        Int      @default(0) @map("invited_count")
  connectedCount      Int      @default(0) @map("connected_count")
  messagedCount       Int      @default(0) @map("messaged_count")

  // Timestamps
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  leads               CampaignLead[]

  @@map("campaigns")
}

// Lead within a campaign
model CampaignLead {
  id              Int             @id @default(autoincrement())
  campaignId      Int             @map("campaign_id")

  // Profile info
  profileUrl      String          @map("profile_url")
  name            String
  firstName       String?         @map("first_name")
  headline        String?
  avatarUrl       String?         @map("avatar_url")

  // Scoring
  temperature     LeadTemperature @default(WARM)

  // Status in funnel
  status          LeadStatus      @default(NEW)

  // Notes
  notes           String?

  // Timestamps
  createdAt       DateTime        @default(now()) @map("created_at")
  invitedAt       DateTime?       @map("invited_at")
  connectedAt     DateTime?       @map("connected_at")
  msg1At          DateTime?       @map("msg1_at")

  // Source tracking
  sourcePostUrl   String?         @map("source_post_url")
  sourceRunId     Int?            @map("source_run_id")

  // Relations
  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Unique: one profile per campaign
  @@unique([campaignId, profileUrl])
  @@map("campaign_leads")
}
